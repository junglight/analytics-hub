              "type": "number"
            },
            {
              "id": "588ec8df-0127-4eb7-ac0a-38bed535392f",
              "name": "abs_error",
              "value": "={{ $json.tolerance === 'exact' ? ($json.pass ? 0 : 1) : Math.abs(Number($json.actual_raw) - Number($json.expected_value)) }}",
              "type": "number"
            }
          ]
        }
      },
