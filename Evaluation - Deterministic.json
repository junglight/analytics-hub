    {
      "parameters": {
        "jsCode": "// Deterministic pass/fail grading. No LLM. Compares actual sub-workflow output\n// against the expected value declared in the eval dataset row.\nconst row = $('Map row').first().json;\nconst result = $input.first().json;\n\nfunction extract(field) {\n  if (field === 'anomaly_count') return result.anomaly_count;\n  if (field === 'top_driver_topic') return (result.drivers && result.drivers[0]) ? result.drivers[0].l1_topic : null;\n  if (field === 'top_driver_share_pct') return (result.drivers && result.drivers[0]) ? Math.abs(result.drivers[0].share_of_total_change_pct) : null;\n  if (field === 'chart_markdown_present') return (result.chart_markdown && result.chart_markdown.startsWith('!['))  ? 1 : 0;\n  return null;\n}\n\nconst actual = extract(row.expected_field);\nconst expected = row.expected_value;\nconst tol = row.tolerance;\n\nlet pass = 0;\nlet detail = '';\n\nif (tol === 'exact') {\n  pass = (String(actual) === String(expected)) ? 1 : 0;\n  detail = `exact match: actual=\"${actual}\" expected=\"${expected}\"`;\n} else {\n  const a = Number(actual), e = Number(expected), t = Number(tol);\n  pass = (Number.isFinite(a) && Math.abs(a - e) <= t) ? 1 : 0;\n  detail = `tolerance ${t}: actual=${a} expected=${e} abs_diff=${Number.isFinite(a) ? Math.abs(a - e).toFixed(2) : 'n/a'}`;\n}\n\nreturn [{ json: {\n  id: row.id,\n  expected_value: row.expected_value,\n  tolerance: row.tolerance,\n  target: row.target,\n  expected_field: row.expected_field,\n  pass,\n  detail,\n  actual_raw: actual,\n}}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        144
      ],
      "id": "95251164-c56f-482b-aed7-9ea011865cff",
      "name": "Grade result"
    },
