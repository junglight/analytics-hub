              "type": "string",
              "value": "=<h2>Support Weekly - week of {{ $json.trend.current_week }}</h2><p>No metric crossed an alert threshold this week.</p><table cellpadding=\"6\" style=\"border-collapse:collapse;font-family:sans-serif;font-size:14px\"><tr style=\"background:#f4f4f4\"><th align=\"left\">Metric</th><th align=\"right\">This week</th><th align=\"right\">Prior</th><th align=\"right\">Change</th></tr><tr><td>Volume</td><td align=\"right\">{{ $json.trend.volume.current }}</td><td align=\"right\">{{ $json.trend.volume.prior }}</td><td align=\"right\">{{ $json.trend.volume.change_pct }}%</td></tr><tr><td>Resolution rate</td><td align=\"right\">{{ $json.trend.resolution_rate.current }}%</td><td align=\"right\">{{ $json.trend.resolution_rate.prior }}%</td><td align=\"right\">{{ $json.trend.resolution_rate.change_pp }} pp</td></tr><tr><td>CSAT</td><td align=\"right\">{{ $json.trend.csat.current }}</td><td align=\"right\">{{ $json.trend.csat.prior }}</td><td align=\"right\">{{ $json.trend.csat.change_pts }}</td></tr></table>"
